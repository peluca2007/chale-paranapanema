# Dados do chalé que NÃO ficam no repositório.
# Copie este arquivo para .env.local e preencha (o .env.local é ignorado pelo Git).
# Na Vercel/Netlify/GitHub, cadastre as mesmas chaves nas variáveis de ambiente do projeto.

# Link do anúncio no Airbnb
VITE_AIRBNB_URL=

# WhatsApp da anfitriã: só números, com DDI+DDD (ex.: 5514999999999)
VITE_WHATSAPP=

# WhatsApp de quem entrega a chave no check-in (Magali), mesmo formato
VITE_KEY_WHATSAPP=

# Wi-Fi do chalé (se a senha ficar vazia, o site mostra "informada na chegada")
VITE_WIFI_NETWORK=
VITE_WIFI_PASSWORD=

# Link do seu GitHub para o crédito no rodapé
VITE_GITHUB_URL=
